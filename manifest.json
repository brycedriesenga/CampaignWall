{
  "name": "Showroom",
  "id": "1428761953216907420",
  "api": "1.0.0",
  "main": "code.js",
  "ui": "ui.html",
  "editorType": [
    "figma",
    "figjam"
  ],
  "documentAccess": "dynamic-page",
  "enablePrivatePluginApi": true,
  "networkAccess": {
    "allowedDomains": [
      "https://api.figma.com",
      "https://figma-alpha-api.s3.us-west-2.amazonaws.com",
      "https://s3-alpha-sig.figma.com",
      "https://s3-alpha.figma.com",
      "https://embed.figma.com",
      "https://www.figma.com"
    ],
    "reasoning": "Reads tagged frames, file versions and team folders through Figma's own REST API, shows Figma's rendered images and profile pictures, and plays live Figma prototypes through Figma's embed."
  },
  "relaunchButtons": [
    {
      "command": "open-panel",
      "name": "Open Showroom"
    },
    {
      "command": "open",
      "name": "Open in Showroom"
    },
    {
      "command": "tags",
      "name": "Edit tags",
      "multipleSelection": true
    }
  ],
  "permissions": [
    "currentuser"
  ],
  "menu": [
    {
      "name": "Open Showroom",
      "command": "open-panel"
    },
    {
      "name": "Show selection in Showroom",
      "command": "open"
    },
    {
      "separator": true
    },
    {
      "name": "Tag selection…",
      "command": "qa-tag",
      "parameters": [
        {
          "name": "Tag",
          "key": "tag",
          "description": "Pick a tag (new tags are offered last)"
        }
      ]
    },
    {
      "name": "Remove tag from selection…",
      "command": "qa-untag",
      "parameters": [
        {
          "name": "Tag",
          "key": "tag",
          "description": "One of the selected frames’ tags"
        }
      ]
    },
    {
      "name": "Set status…",
      "command": "qa-status",
      "parameters": [
        {
          "name": "Status",
          "key": "status",
          "description": "Draft, In review, Approved or No status"
        }
      ]
    },
    {
      "name": "Update tagged frames",
      "command": "qa-update"
    },
    {
      "separator": true
    },
    {
      "name": "Open wall…",
      "command": "qa-wall",
      "parameters": [
        {
          "name": "Tag",
          "key": "tag",
          "description": "A tag, or All tagged frames"
        }
      ]
    }
  ]
}
